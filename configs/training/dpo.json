{
  "model": {
    "embedding_dim": 512,
    "d_model": 512,
    "n_heads": 8,
    "context_layers": 6,
    "denoiser_layers": 4,
    "d_ff": 2048,
    "max_seq_len": 45,
    "dropout": 0.1,
    "num_diffusion_steps": 1000,
    "variance_schedule": "cosine",
    "beta_start": 1e-4,
    "beta_end": 0.02,
    "r_group_dim": 512
  },
  "training": {
    "vocab_file": "./data/processed/helm_vocab.json",
    "embeddings_dir": "./data/processed/unimol_embeddings",
    "data_dir": "./data/processed",
    "batch_size": 8,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "checkpoint_dir": "./outputs/checkpoints/dpo",
    "device": "cuda",
    "num_workers": 4,
    "pretrained_checkpoint": "./outputs/checkpoints/finetune_permeability_top1000/latest.pt"
  },
  "generation": {
    "checkpoint_path": "./outputs/checkpoints/dpo/dpo_latest.pt",
    "num_samples": 1001,
    "max_length": 7,
    "min_length": 7,
    "use_ddim": true,
    "ddim_steps": 50,
    "lambda_gpt": 0.1,
    "predict_ring_bonds": true,
    "cyclization_mode": "predict_ring",
    "ring_bond_threshold": 0.5,
    "ring_top_k": 1,
    "use_embedding_norm": true,
    "mapping_sample": true,
    "mapping_top_k": 8,
    "mapping_top_p": 0.95,
    "mapping_temperature": 0.85,
    "mapping_frequency_penalty": 0.35,
    "output_file": "./outputs/samples/dpo_generate_data/helm_dpo_samples.txt",
    "verbose": true,
    "seed": null
  },
  "dpo": {
    "beta_dpo": 0.1,
    "lr": 1e-5,
    "num_epochs": 10,
    "freeze_mode": "denoiser_only",
    "sample_files": [
      "./outputs/samples/dpo_train_data/helm_chembl32only_r1r2_cyclized.txt",
      "./outputs/samples/dpo_train_data/cpp_lambda0_3_latest.txt"
    ],
    "vina_score_file": "./outputs/samples/dpo_train_data/combined_candidates.vina.csv",
    "perm_score_file": "./outputs/samples/dpo_train_data/combined_candidates.perm.csv",
    "top_ratio": 0.1,
    "bottom_ratio": 0.1,
    "winner_pool_ratio": 0.3,
    "loser_pool_ratio": 0.3,
    "winner_diversity_lambda": 0.45,
    "loser_diversity_lambda": 0.2,
    "pair_strategy": "nearest_hard_negative",
    "min_reward_gap": 0.5,
    "preserve_pairing": true,
    "dock_box_size": 30.0,
    "dock_seed": 42,
    "vina_exhaustiveness": 8,
    "vina_n_poses": 4,
    "vina_show_progress": true,
    "unidock_binary": "unidock",
    "unidock_batch_size": 64,
    "unidock_search_mode": "balance",
    "unidock_scoring": "vina",
    "unidock_refine_step": 3,
    "unidock_max_step": 20,
    "unidock_max_gpu_memory": 0,
    "unidock_keep_workdir": false,
    "unidock_verbosity": 0,
    "reward_normalize": true,
    "reward_w_vina": 1.0,
    "reward_w_perm": 0.5,
    "reward_w_chemistry": 0.35,
    "chemistry_target_length": 7,
    "log_interval": 5,
    "save_interval_epochs": 5
  }
}
