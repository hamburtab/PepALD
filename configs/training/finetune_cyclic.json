{
  "model": {
    "embedding_dim": 512,
    "d_model": 512,
    "n_heads": 8,
    "context_layers": 6,
    "denoiser_layers": 6,
    "d_ff": 2048,
    "max_seq_len": 45,
    "dropout": 0.3,
    "num_diffusion_steps": 1000,
    "variance_schedule": "linear",
    "beta_start": 1e-4,
    "beta_end": 0.02,
    "r_group_dim": 512,
    "ring_hidden_dim": 256,
    "num_ring_types": 4
  },
  "training": {
    "train_data_file": "./data/processed/helm_sequences_cycpeptmpdb.txt",
    "vocab_file": "./data/processed/helm_vocab.json",
    "embeddings_dir": "./data/processed/unimol_embeddings",
    "data_dir": "./data/processed",
    "batch_size": 16,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "num_epochs": 40,
    "warmup_steps": 500,
    "max_grad_norm": 1.0,
    "sample_positions": 45,
    "log_interval": 50,
    "save_interval": 500,
    "checkpoint_dir": "./checkpoints/ald_cyclic_6layer",
    "device": "cuda",
    "use_amp": false,
    "num_workers": 4,
    "finetune_mode": true,
    "pretrained_checkpoint": "./checkpoints/ald/checkpoint_epoch_99.pt",
    "cyclic_only": true,
    "ring_loss_weight": 0.5,
    "ce_loss_weight": 0.5,
    "freeze_embedding": false,
    "freeze_context_encoder": false,
    "freeze_diffusion": false
  },
  "generation": {
    "checkpoint_path": "./checkpoints/ald_cyclic_6layer/checkpoint_epoch_40.pt",
    "num_samples": 1000,
    "max_length": 12,
    "min_length": 7,
    "use_ddim": true,
    "ddim_steps": 10,
    "lambda_gpt": 0.1,
    "predict_ring_bonds": true,
    "ring_bond_threshold": 0.5,
    "ring_top_k": 1,
    "use_embedding_norm": true,
    "output_file": "./outputs/samples/finetune/cycpeptMPDB_samples.txt",
    "verbose": true,
    "seed": null
  }
}
