{
  "model": {
    "embedding_dim": 512,
    "d_model": 512,
    "n_heads": 8,
    "context_layers": 6,
    "denoiser_layers": 4,
    "d_ff": 2048,
    "max_seq_len": 45,
    "dropout": 0.1,
    "num_diffusion_steps": 1000,
    "variance_schedule": "cosine",
    "beta_start": 1e-4,
    "beta_end": 0.02
  },
  "training": {
    "train_data_file": "./data/helm_sequences_chembl32.txt",
    "vocab_file": "./data/helm_vocab.json",
    "embeddings_dir": "./unimol_embeddings",
    "data_dir": "./data",
    "batch_size": 32,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "num_epochs": 99,
    "warmup_steps": 1000,
    "max_grad_norm": 1.0,
    "sample_positions": 45,
    "log_interval": 100,
    "save_interval": 1000,
    "checkpoint_dir": "./checkpoints/ald",
    "device": "cuda",
    "use_amp": false,
    "num_workers": 4
  },
  "generation": {
    "checkpoint_path": "./checkpoints/ald/latest.pt",
    "num_samples": 100,
    "max_length": 20,
    "min_length": 4,
    "use_ddim": true,
    "ddim_steps": 50,
    "predict_ring_bonds": true,
    "ring_bond_threshold": 0.5,
    "use_embedding_norm": true,
    "output_file": "./generated_samples/samples.txt",
    "verbose": true,
    "seed": null
  }
}
